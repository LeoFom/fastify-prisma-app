{
  "name": "fastify-todo-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --env-file-if-exists=.env.test --test tests/*.test.cjs",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prisma": "npx prisma studio",
    "ssh-use-key": "ssh-add --apple-use-keychain ~/.ssh/id_ed25519",
    "migration": "npx prisma migrate dev",
    "migration reset": "npx prisma migrate reset",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "format:check": "node scripts/check-format.mjs",
    "test:tooling": "node --test tests/tooling-format.test.cjs",
    "lint": "eslint . --max-warnings=0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.2.9",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.8",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.1",
    "pg": "^8.20.0",
    "slugify": "^1.6.9",
    "transliteration": "^2.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.23.1",
    "eslint": "9.39.5",
    "pino-pretty": "^13.1.3",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.74.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  }
}
